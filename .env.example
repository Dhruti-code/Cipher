# ==============================================================================
# ENVIRONMENT VARIABLES REFERENCE
# ==============================================================================
# Use these environment variables when configuring your local environment
# or your deployed Render services (Backend Web Service & Frontend Static Site).
# ==============================================================================

# ------------------------------------------------------------------------------
# BACKEND (Render Web Service)
# ------------------------------------------------------------------------------
# PORT: The port the Express/Socket.IO server listens on.
# Render automatically injects this variable in production (defaults to 3001 locally).
PORT=3001

# NODE_ENV: Set to 'production' on Render.
NODE_ENV=development

# CLIENT_URL: Allowed frontend origin(s) for CORS and Socket.IO.
# In production on Render: set to your deployed frontend URL, e.g. https://my-chat-app.onrender.com
# Multiple comma-separated origins are supported (e.g. https://my-chat-app.onrender.com,http://localhost:5173).
CLIENT_URL=http://localhost:5173

# DATABASE_PATH: Path to the SQLite database file.
# Default: ./data/chat.db (relative to server working directory).
# NOTE FOR RENDER: Default Render Web Service disk is ephemeral (wiped on redeploys).
# To retain data permanently, attach a Render Persistent Disk (e.g. /var/data)
# and set DATABASE_PATH=/var/data/chat.db
DATABASE_PATH=./data/chat.db

# ------------------------------------------------------------------------------
# FRONTEND (Render Static Site)
# ------------------------------------------------------------------------------
# VITE_API_URL: Public REST API endpoint URL for the client.
# In local development: defaults to /api (proxied by Vite to http://localhost:3001).
# In production on Render: set to your deployed backend URL, e.g. https://my-chat-server.onrender.com/api
VITE_API_URL=http://localhost:3001/api

# VITE_SOCKET_URL: Public Socket.IO WebSocket endpoint URL for the client.
# In local development: defaults to http://localhost:3001.
# In production on Render: set to your deployed backend root URL, e.g. https://my-chat-server.onrender.com
VITE_SOCKET_URL=http://localhost:3001
