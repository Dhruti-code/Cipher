# ==============================================================================
# SERVER ENVIRONMENT VARIABLES (Render Web Service)
# ==============================================================================

# PORT: Listening port for Express & Socket.IO. Render injects this automatically.
PORT=3001

# NODE_ENV: Set to 'production' in Render Web Service environment.
NODE_ENV=development

# CLIENT_URL: Allowed frontend origin(s) for CORS and Socket.IO.
# In production: https://<your-frontend-site>.onrender.com
# Multiple comma-separated origins are supported.
CLIENT_URL=http://localhost:5173

# DATABASE_PATH: Path to the SQLite database file.
# Default: ./data/chat.db.
# If using a Render Persistent Disk mounted at /var/data, set to: /var/data/chat.db
DATABASE_PATH=./data/chat.db
