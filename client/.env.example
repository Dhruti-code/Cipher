# ==============================================================================
# CLIENT ENVIRONMENT VARIABLES (Render Static Site)
# ==============================================================================

# VITE_API_URL: Public REST API URL for the backend.
# In production on Render: https://<your-backend-service>.onrender.com/api
# In local dev: http://localhost:3001/api (or empty to use local Vite proxy)
VITE_API_URL=http://localhost:3001/api

# VITE_SOCKET_URL: Public Socket.IO URL for the backend.
# In production on Render: https://<your-backend-service>.onrender.com
# In local dev: http://localhost:3001
VITE_SOCKET_URL=http://localhost:3001
